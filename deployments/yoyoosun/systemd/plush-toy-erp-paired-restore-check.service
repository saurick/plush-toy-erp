[Unit]
Description=Plush Toy ERP weekly paired offsite backup restore check
Requires=docker.service
After=docker.service
RequiresMountsFor=/mnt/plush-toy-erp-offsite/database
OnFailure=plush-toy-erp-backup-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/plush-toy-erp/paired-backup.env
ExecStartPre=/usr/bin/mountpoint --quiet /mnt/plush-toy-erp-offsite/database
ExecStart=/usr/local/bin/node ${BACKUP_TOOL_DIR}/scripts/deploy/backup-set/cli.mjs restore-check --offsite-dir ${BACKUP_OFFSITE_DIR} --identity-file ${BACKUP_AGE_IDENTITY_FILE} --work-dir ${BACKUP_RESTORE_WORK_DIR} --report ${BACKUP_RESTORE_REPORT} --max-age-hours ${BACKUP_MAX_AGE_HOURS}
TimeoutStartSec=45min
TimeoutStopSec=3min
KillMode=mixed
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
