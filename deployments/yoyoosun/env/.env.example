# yoyoosun 私有化部署 env 样例。复制到受控外部路径后再填写真实值，禁止把真实 .env 提交到 Git。

PROJECT_SLUG=plush-toy-erp-production
ERP_CUSTOMER_KEY=yoyoosun
APP_IMAGE=plush-toy-erp-server:<release-tag>
WEB_IMAGE=plush-toy-erp-web:<release-tag>
TZ=Asia/Shanghai

ATTACHMENT_S3_BUCKET=plush-production-133-files
ATTACHMENT_S3_ACCESS_KEY_ID=change-this-attachment-access-key
ATTACHMENT_S3_SECRET_ACCESS_KEY=change-this-attachment-secret-key

POSTGRES_MEM_LIMIT=512m
POSTGRES_MEM_RESERVATION=256m
JAEGER_MEM_LIMIT=192m
JAEGER_MEM_RESERVATION=96m
APP_MEM_LIMIT=2g
APP_MEM_RESERVATION=768m
APP_SHM_SIZE=256m
APP_TMPFS_SIZE=256m
WEB_MEM_LIMIT=96m
WEB_MEM_RESERVATION=48m

# 应用、迁移、备份和初始化管理员密码必须分别生成，不能复用。
POSTGRES_PASSWORD=change-this-prod-postgres-password
POSTGRES_APP_PASSWORD=change-this-prod-app-password
POSTGRES_MIGRATOR_PASSWORD=change-this-prod-migrator-password
POSTGRES_BACKUP_PASSWORD=change-this-prod-backup-password
# 兼容现有 preflight / 一次性管理员初始化；值必须与 app 密码和数据库名一致。
POSTGRES_DSN=postgres://erp_app:change-this-prod-app-password@postgres:5432/plush_erp_production?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_STARTUP_TIMEOUT=60s
POSTGRES_DB=plush_erp_production
POSTGRES_USER=postgres
POSTGRES_DATA_DIR=/root/deploy/plush-toy-erp-production/data/postgres
MIGRATION_LOCK_FILE=/root/deploy/plush-toy-erp-production/run/atlas-migrate.lock

TRACE_ENDPOINT=jaeger:4318
WEB_API_ORIGIN=http://app-server:8300
WEB_PROXY_PREFIXES=/rpc,/templates,/readyz/runtime-identity
WEB_PROXY_TIMEOUT_MS=30000
WEB_READINESS_TIMEOUT_MS=2000
WEB_SHUTDOWN_TIMEOUT_MS=10000

ERP_PDF_CHROME_PATH=/usr/bin/chromium
ERP_PDF_RENDER_CONCURRENCY=4
ERP_PDF_QUEUE_CAPACITY=2
ERP_PDF_WARMUP=async
APP_JWT_SECRET=change-this-prod-jwt-secret
APP_AUTH_SMS_MODE=provider
APP_AUTH_SMS_ALIYUN_ACCESS_KEY_ID=change-this-aliyun-access-key-id
APP_AUTH_SMS_ALIYUN_ACCESS_KEY_SECRET=change-this-aliyun-access-key-secret
APP_AUTH_SMS_ALIYUN_SIGN_NAME=change-this-aliyun-sign-name
APP_AUTH_SMS_ALIYUN_TEMPLATE_CODE=change-this-aliyun-template-code
APP_ADMIN_USERNAME=admin
# 首次初始化新库 bootstrap 管理员时，临时设置 BOOTSTRAP_ADMIN_ONCE=true 并注入 APP_ADMIN_PASSWORD；
# 初始化成功后必须移除 APP_ADMIN_PASSWORD 并恢复为 false。
BOOTSTRAP_ADMIN_ONCE=false

# 生产 / 客户试用环境必须关闭 debug 写能力。
ERP_DEBUG_ENV=prod
ERP_DEBUG_SEED_ENABLED=false
ERP_DEBUG_CLEANUP_ENABLED=false
ERP_DEBUG_BUSINESS_CLEAR_ENABLED=false
ERP_DEBUG_CLEANUP_SCOPE=none

POSTGRES_PORT=55438
POSTGRES_BIND_ADDR=127.0.0.1
APP_HTTP_PORT=8345
APP_HTTP_BIND_ADDR=127.0.0.1
WEB_DESKTOP_BIND_ADDR=127.0.0.1
WEB_DESKTOP_PORT=5215

JAEGER_6831_PORT=63002
JAEGER_6832_PORT=63003
JAEGER_UI_PORT=63005
JAEGER_14268_PORT=63006
JAEGER_14250_PORT=63007
JAEGER_9411_PORT=63008
JAEGER_OTLP_GRPC_PORT=63009
JAEGER_OTLP_HTTP_PORT=63010
PROMETHEUS_SERVER_URL=http://host.docker.internal:3004

# 业务运行配置样例。真实外部地址、证书路径和 secret 放受控配置，不写进本仓库。
CORS_ALLOWED_ORIGINS=https://erp.yoyoosun.net
WEB_PUBLIC_BASE_URL=https://erp.yoyoosun.net
BACKUP_DIR=/root/deploy/plush-toy-erp-production/backups
ATTACHMENT_DATA_DIR=/srv/raid5/plush-toy-erp/production-133/attachments
ERP_ALLOW_CUSTOMER_TRIAL_CONFIG=0
ERP_CUSTOMER_TRIAL_TARGET=
