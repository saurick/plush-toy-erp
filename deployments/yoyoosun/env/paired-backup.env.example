# 安装前把 BACKUP_TOOL_DIR 指向已验证的固定工具目录。
BACKUP_TOOL_DIR=/root/deploy/plush-toy-erp-production/backup-tools/VERIFIED_TOOL
COMPOSE_PROJECT_NAME=plush-toy-erp-production
BACKUP_DATABASE=plush_erp_production
BACKUP_COMPOSE_FILE=/root/deploy/plush-toy-erp-production/current/server/deploy/compose/prod/compose.yml
BACKUP_RUNTIME_ENV=/root/deploy/plush-toy-erp-production/runtime/.env.production-133
BACKUP_DIR=/root/deploy/plush-toy-erp-production/backups/paired
BACKUP_OFFSITE_DIR=/mnt/plush-toy-erp-offsite/database/production-133
BACKUP_AGE_RECIPIENT_FILE=/etc/plush-toy-erp/backup-age-recipient.txt
BACKUP_AGE_IDENTITY_FILE=/etc/plush-toy-erp/backup-age-identity.txt
BACKUP_RETENTION_COUNT=7
BACKUP_MAX_AGE_HOURS=36
BACKUP_RESTORE_REPORT=/var/lib/plush-toy-erp/backup/paired/latest-restore-check.json
BACKUP_RESTORE_WORK_DIR=/root/deploy/plush-toy-erp-production/backups/restore-work-paired
