{
  "schemaVersion": "yoyoosun-credential-contract/v5",
  "customerCode": "yoyoosun",
  "targets": {
    "demo-133": {
      "deploymentTarget": "demo-133",
      "commandTarget": "customer-trial-133",
      "database": "plush_erp_demo_v1",
      "datasetVersion": "2026.08.15-v6",
      "targetIdentity": "customer-trial-133:2026.08.15-v6",
      "adminCredential": "admin",
      "nonAdminPolicy": "rotate",
      "nonAdminCredential": "uat",
      "smsLoginPolicy": "bind-when-configured"
    },
    "customer-test-133": {
      "deploymentTarget": "customer-test-133",
      "commandTarget": "customer-test-133",
      "database": "plush_erp_customer_test_v1",
      "targetIdentity": "deployment-target:customer-test-133:clean-acceptance",
      "adminCredential": "admin",
      "nonAdminPolicy": "preserve",
      "smsLoginPolicy": "not-managed"
    }
  },
  "credentials": {
    "admin": {
      "username": "admin",
      "environmentVariable": "MANUAL_ACCEPTANCE_ADMIN_PASSWORD",
      "credentialSource": "contract-fixed-test",
      "fixedTestPassword": "adminadmin"
    },
    "uat": {
      "usernames": [
        "uat_boss",
        "uat_sales",
        "uat_purchase",
        "uat_production",
        "uat_warehouse",
        "uat_quality",
        "uat_finance",
        "uat_pmc",
        "uat_engineering",
        "uat_admin"
      ],
      "environmentVariable": "MANUAL_ACCEPTANCE_UAT_PASSWORD",
      "credentialSource": "contract-fixed-test",
      "fixedTestPassword": "12345678"
    }
  },
  "policy": {
    "passwordsMustDiffer": true,
    "registeredSimplePasswordTargets": ["local-dev", "demo-133", "customer-test-133"],
    "deploymentTargetsUseFixedPublicTestAdminCredential": true,
    "demoUsesFixedPublicTestNonAdminCredential": true,
    "rotateAfterCreateRestorePromotionOrRollback": true,
    "revokeExistingSessionsOnRotation": true,
    "requireCredentialLoginMatrixBeforeCutover": true
  },
  "smsLoginIdentity": {
    "username": "admin",
    "phoneRequiredWhenProviderEnabled": false,
    "verifyPhoneIdentityWhenConfigured": true,
    "environmentVariable": "MANUAL_ACCEPTANCE_SMS_PHONE",
    "keychain": {
      "service": "plush-toy-erp-yoyoosun-sms-phone",
      "account": "customer-trial-133:admin"
    }
  },
  "redaction": {
    "containsSecrets": false,
    "contractContainsPublicTestPasswords": true,
    "storePasswords": false,
    "storeTokens": false,
    "storePhoneNumber": false,
    "storeRawProfiles": false
  }
}
