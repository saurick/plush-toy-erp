# 安装 systemd 定时器前复制到 /etc/plush-toy-erp/backup.env，并按目标机实际路径修改。
BACKUP_COMPOSE_FILE=/srv/plush-toy-erp/current/server/deploy/compose/prod/compose.yml
BACKUP_RUNTIME_ENV=/etc/plush-toy-erp/runtime.env
BACKUP_DIR=/var/backups/plush-toy-erp/database
# 该目录必须已挂载到不同文件系统，并包含内容为 plush-toy-erp-offsite-v1 的
# .plush-toy-erp-offsite-target 普通文件；脚本不会在挂载缺失时自动创建目录。
BACKUP_OFFSITE_DIR=/mnt/plush-toy-erp-offsite/database
BACKUP_AGE_RECIPIENT_FILE=/etc/plush-toy-erp/backup-age-recipient.txt
BACKUP_AGE_IDENTITY_FILE=/etc/plush-toy-erp/backup-age-identity.txt
BACKUP_RETENTION_DAYS=35
BACKUP_MAX_AGE_HOURS=36
BACKUP_RESTORE_REPORT=/var/lib/plush-toy-erp/backup/latest-restore-check.json
BACKUP_POSTGRES_IMAGE=postgres:18.1
