{
  "name": "plush-toy-erp-web",
  "version": "1.0.0",
  "description": "Frontend for Plush Toy ERP built with Vite and React",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.21.x",
    "pnpm": "10.34.x"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "antd": "^5.29.3",
    "js-sha256": "0.11.1",
    "jwt-decode": "^4.0.0",
    "mermaid": "^11.17.2",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.0.7",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "remarkable": "^2.0.1",
    "remarkable-react": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.1",
    "dayjs": "^1.11.21",
    "eslint": "^9.39.5",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "7.1.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tailwindcss": "^3.4.19",
    "tinycolor2": "^1.6.0",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.16",
      "uuid": "13.0.1"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "build:all": "node ../scripts/gen-error-codes.mjs && vite build --config vite.config.mjs",
    "build:committed": "vite build --config vite.config.mjs",
    "start": "node ./scripts/startWebDev.mjs",
    "start:isolated": "node ./scripts/startWebDev.mjs --isolated",
    "start:restart": "node ./scripts/startWebDev.mjs --local --restart",
    "start:frontend-only": "node ./scripts/startWebDev.mjs --frontend-only",
    "start:yoyoosun": "node ./scripts/startYoyoosunDev.mjs",
    "audit:yoyoosun-entry": "node ./scripts/yoyoosunLocalEntryAudit.mjs",
    "lint": "eslint --ext .js --ext .jsx src/",
    "lint:fix": "eslint --fix --ext .js --ext .jsx src/",
    "css": "stylelint \"src/**/*.{css,scss,sass}\"",
    "style:l1": "node ./scripts/styleL1.mjs",
    "smoke:mobile-auth-login-route": "node ./scripts/mobileAuthLoginRouteSmoke.mjs",
    "smoke:mobile-workflow-runtime-browser": "node ./scripts/mobileWorkflowRuntimeBrowserSmoke.mjs",
    "smoke:trial-demo-browser": "node ./scripts/trialDemoAccountBrowserSmoke.mjs",
    "smoke:purchase-receipt-real-write": "node ./scripts/purchaseReceiptRealWriteBrowserE2E.mjs --accept-persistent-test-data",
    "smoke:purchase-contract-real-login": "node ./scripts/purchaseContractRealLoginSmoke.mjs",
    "smoke:processing-contract-real-login": "node ./scripts/processingContractRealLoginSmoke.mjs",
    "serve:prod": "node ./scripts/serveStaticApp.mjs",
    "preview:yoyoosun": "node ./scripts/previewYoyoosun.mjs",
    "test": "node --test",
    "gen:error-codes": "node ../scripts/gen-error-codes.mjs",
    "prebuild": "node ../scripts/gen-error-codes.mjs",
    "pretest": "node ../scripts/gen-error-codes.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
